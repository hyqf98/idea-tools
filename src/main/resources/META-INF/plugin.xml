<idea-plugin>
    <!-- Plugin name and description -->
    <name>IdeaTools</name>
    <id>io.github.ideatools</id>
    <version>1.0.1</version>

    <!-- Vendor information -->
    <vendor email="iamxiaohaijun@gmail.com" url="https://github.com/hyqf98/IdeaTools">IdeaTools</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
      <h2>IdeaTools - IntelliJ IDEA Productivity Plugin</h2>
      <p>A comprehensive productivity plugin for Java developers that enhances development experience with JavaDoc generation, AI integration, API management, and MyBatis enhancement.</p>

      <h3>Core Features</h3>
      <ul>
        <li><b>JavaDoc Generation:</b> Template-based or AI-powered comment generation for files, classes, methods, and fields (Alt+Shift+J, Alt+J)</li>
        <li><b>AI Integration:</b> Support for OpenAI GPT, Claude, Gemini, DeepSeek, Qwen, GLM, Wenxin, Azure OpenAI, and local Ollama models</li>
        <li><b>API Management:</b> Spring MVC REST API scanner with tree view, search dialog (Ctrl+\), and navigation features</li>
        <li><b>MyBatis Enhancement:</b> Smart navigation between Mapper and XML, parameter completion with #{} support, reference jumping, and SQL tag generation</li>
        <li><b>Development Tools:</b> AI-powered code generation from database schema, naming convention converter (Ctrl+Shift+U), and project view JavaDoc decorator</li>
      </ul>

      <h3>Key Highlights</h3>
      <ul>
        <li>Bidirectional navigation between Mapper interfaces and XML files</li>
        <li>Intelligent parameter completion with @Param and nested object support</li>
        <li>Swagger/OpenAPI annotation integration (@Operation, @Tag, @Schema)</li>
        <li>Customizable Velocity templates for JavaDoc generation</li>
        <li>Feature toggle system with 17+ configurable switches</li>
        <li>Syntax highlighting for MyBatis XML tags</li>
      </ul>

      <h3>Configuration</h3>
      <p>Settings → Other Settings → Easy Config</p>
      <ul>
        <li>Feature Toggles: Enable/disable specific modules</li>
        <li>JavaDoc Config: Customize comment templates</li>
        <li>LLM Config: Configure AI providers and models</li>
        <li>Code Generation: Database connection and templates</li>
      </ul>

      <h3>Quick Start</h3>
      <ul>
        <li><b>Alt+Shift+J:</b> Generate file comment</li>
        <li><b>Alt+J:</b> Generate element comment</li>
        <li><b>Ctrl+\:</b> Quick API search</li>
        <li><b>Ctrl+Shift+U:</b> Convert property naming</li>
        <li><b>Ctrl+Shift+G:</b> AI code generation</li>
      </ul>
    ]]></description>

    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <!-- Extension points -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册项目视图节点装饰器，用于在文件列表中显示注释 -->
        <projectViewNodeDecorator implementation="io.github.ideatools.comment.FileCommentDecorator"/>

        <!-- 注册MyBatis Mapper接口的行标记提供者，用于显示导航图标 -->
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="io.github.ideatools.ui.mybatis.MapperLineMarkerProvider"/>

        <!-- 注册MyBatis XML SQL标签的行标记提供者，用于从 XML 跳转到 Mapper 接口方法 -->
        <codeInsight.lineMarkerProvider language="XML"
                                        implementationClass="io.github.ideatools.ui.mybatis.XmlSqlTagLineMarkerProvider"/>

        <!-- 注册MyBatis XML文件注解器，用于语法高亮 -->
        <annotator language="XML"
                   implementationClass="io.github.ideatools.ui.mybatis.MyBatisXmlAnnotator"/>

        <!-- 注册MyBatis XML参数引用贡献者，用于参数到Java字段的引用跳转 -->
        <psi.referenceContributor language="XML"
                                  implementation="io.github.ideatools.service.mybatis.MyBatisParamReferenceContributor"/>

        <!-- 注册MyBatis XML代码补全贡献者,用于参数智能提示 -->
        <!-- 不指定language以支持语言注入场景(如XML中的SQL注入为MySQL) -->
        <completion.contributor language="any"
                                order="first"
                                id="io.github.ideatools.mybatis.completion"
                                implementationClass="io.github.ideatools.service.mybatis.MyBatisXmlCompletionContributor"/>

        <!-- 注册MyBatis意图操作，用于Ctrl+回车菜单 -->
        <intentionAction>
            <className>io.github.ideatools.intention.MyBatisSelectIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.ideatools.intention.MyBatisInsertIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.ideatools.intention.MyBatisUpdateIntention</className>
            <category>MyBatis</category>
        </intentionAction>
        <intentionAction>
            <className>io.github.ideatools.intention.MyBatisDeleteIntention</className>
            <category>MyBatis</category>
        </intentionAction>
    </extensions>

    <!-- Plugin metadata -->
    <change-notes><![CDATA[
    <h3>v1.0.0 - 最新更新</h3>
    <h4>新增功能:</h4>
    <ul>
      <li>项目视图注释显示功能</li>
      <li>在项目树中显示 JavaDoc 注释</li>
      <li>显示目录的 package-info.java 描述</li>
      <li>显示 Java 文件的类描述</li>
      <li>自动提取和显示注释</li>
      <li>线程安全的 PSI 元素访问</li>
    </ul>

    <h4>历史更新:</h4>
    <ul>
      <li>IDEA 右侧边栏的 API 接口管理面板</li>
      <li>Spring MVC 注解支持 (@RestController、@Controller、@RequestMapping 等)</li>
      <li>元注解的递归处理</li>
      <li>支持 Swagger/OpenAPI 注解 (@Operation、@Tag 等)</li>
      <li>从 Swagger/OpenAPI 注解中提取 Controller 描述</li>
      <li>在树形结构视图中按 Controller 分组 API</li>
      <li>修复 API 路径参数显示问题(缺少右括号)</li>
      <li>修复树形视图中的双击导航问题</li>
      <li>通过移除 PSI 元素序列化修复插件启动和导航问题</li>
      <li>修复树节点对象处理以实现正确导航</li>
      <li>修复自定义树节点实现以正确存储和检索 API 信息</li>
      <li>修复处理循环注解引用时的无限递归问题</li>
      <li>修复访问 PSI 元素时的线程安全问题</li>
      <li>实现带实时 UI 更新的增量扫描</li>
      <li>双击导航到对应的 Java 方法</li>
    </ul>
    ]]></change-notes>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.github.ideatools.ui.config.FeatureToggleService"/>
        <applicationService serviceImplementation="io.github.ideatools.ui.config.LLMConfigState"/>
        <applicationService serviceImplementation="io.github.ideatools.service.llm.LLMService"/>
        <applicationService serviceImplementation="io.github.ideatools.ui.config.DocConfigService"/>
        <applicationService serviceImplementation="io.github.ideatools.ui.config.CodeGenConfigState"/>
        <applicationConfigurable
                parentId="other"
                instance="io.github.ideatools.ui.config.EasyConfig"
                id="io.github.ideatools.ui.config.EasyConfig"
                displayName="Easy Config">
            <configurable instance="io.github.ideatools.ui.config.FeatureToggleConfig"
                          id="io.github.ideatools.ui.config.EasyConfig.01.FeatureToggle"
                          displayName="功能开关"
                          groupWeight="40"/>
            <configurable instance="io.github.ideatools.ui.config.LLMConfig"
                          id="io.github.ideatools.ui.config.EasyConfig.02.LLMConfig"
                          displayName="大模型配置"
                          groupWeight="30"/>
            <configurable instance="io.github.ideatools.ui.config.CodeGenConfig"
                          id="io.github.ideatools.ui.config.EasyConfig.04.CodeGenConfig"
                          displayName="AI代码生成"
                          groupWeight="10"/>
        </applicationConfigurable>
        <!-- HTTP接口测试配置 - 项目级别 -->
        <projectConfigurable parentId="io.github.ideatools.ui.config.EasyConfig"
                             instance="io.github.ideatools.ui.config.ApiTestConfig"
                             id="io.github.ideatools.ui.config.EasyConfig.05.ApiTestConfig"
                             displayName="HTTP接口测试"
                             groupWeight="5"/>
        <!-- Java注释配置改为项目级别配置 -->
        <projectConfigurable parentId="io.github.ideatools.ui.config.EasyConfig"
                             instance="io.github.ideatools.ui.config.DocConfig"
                             id="io.github.ideatools.ui.config.EasyConfig.03.DocConfig"
                             displayName="Java注释配置"
                             groupWeight="20"/>
        <applicationService serviceImplementation="io.github.ideatools.action.doc.listener.FileSaveListenerManager"/>
        <notificationGroup id="Easy Docs Notification Group"
                           displayType="BALLOON"
                           key="notification.group.name"/>
    </extensions>


    <applicationListeners>
        <listener class="io.github.ideatools.action.doc.listener.FileSaveListenerManager"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <listener class="io.github.ideatools.action.doc.listener.FileCreationListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <!-- 项目启动活动 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- MyBatis Mapper XML文件扫描和监听 -->
        <postStartupActivity implementation="io.github.ideatools.listener.MapperXmlStartupActivity"/>
    </extensions>

    <actions>
        <group id="JavaDocMenus" popup="true" description="Java Doc" text="Java Doc">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="GenerateFileCommentAction"
                    class="io.github.ideatools.action.doc.actions.GenerateFileCommentAction"
                    text="当前文件生成注释"
                    description="当前文件生成注释">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift J"/>
            </action>
            <action id="GenerateElementCommentAction"
                    class="io.github.ideatools.action.doc.actions.GenerateElementCommentAction"
                    text="当前元素生成注释"
                    description="当前元素生成注释">
                <keyboard-shortcut keymap="$default" first-keystroke="alt J"/>
            </action>
            <action id="GenerateFileCommentByAiAction"
                    class="io.github.ideatools.action.doc.actions.GenerateFileCommentByAiAction"
                    text="当前文件生成注释(AI)"
                    description="使用AI为当前文件生成注释"/>
            <action id="GenerateElementCommentByAiAction"
                    class="io.github.ideatools.action.doc.actions.GenerateElementCommentByAiAction"
                    text="当前元素生成注释(AI)"
                    description="使用AI为当前元素生成注释"/>
            <action id="RemoveElementCommentsAction"
                    class="io.github.ideatools.action.doc.actions.RemoveElementCommentsAction"
                    text="删除当前元素注释"
                    description="删除当前元素注释"/>
            <action id="RemoveFileCommentsAction"
                    class="io.github.ideatools.action.doc.actions.RemoveFileCommentsAction"
                    text="删除当前文件注释"
                    description="删除当前文件注释"/>
        </group>

        <group id="MyBatisActionGroup" text="MyBatis Action" description="MyBatis SQL Tag Generation" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="JavaDocMenus"/>
            <action id="CreateSelectTagAction"
                    class="io.github.ideatools.action.mybatis.CreateSelectTagAction"
                    text="创建Select方法"
                    description="在XML中为选中的Mapper方法创建select标签"/>
            <action id="CreateInsertTagAction"
                    class="io.github.ideatools.action.mybatis.CreateInsertTagAction"
                    text="创建Insert方法"
                    description="在XML中为选中的Mapper方法创建insert标签"/>
            <action id="CreateUpdateTagAction"
                    class="io.github.ideatools.action.mybatis.CreateUpdateTagAction"
                    text="创建Update方法"
                    description="在XML中为选中的Mapper方法创建update标签"/>
            <action id="CreateDeleteTagAction"
                    class="io.github.ideatools.action.mybatis.CreateDeleteTagAction"
                    text="创建Delete方法"
                    description="在XML中为选中的Mapper方法创建delete标签"/>
        </group>

        <group id="PropertyConversionGroup" text="属性转换" description="Property Conversion">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="MyBatisActionGroup"/>
            <action id="PropertyConversionAction"
                    class="io.github.ideatools.action.conversion.PropertyConversionAction"
                    text="转换选中属性"
                    description="将选中的属性名转换为不同格式">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift U"/>
            </action>
        </group>

        <!-- API搜索动作 -->
        <action id="ApiSearchAction"
                class="io.github.ideatools.action.api.ApiSearchAction"
                text="API搜索"
                description="搜索并跳转到API接口">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl BACK_SLASH"/>
        </action>

        <!-- AI代码生成动作 -->
        <action id="GenerateCodeByAiAction"
                class="io.github.ideatools.action.codegen.GenerateCodeByAiAction"
                text="AI代码生成"
                description="使用AI根据数据库表结构生成代码">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift G"/>
        </action>
    </actions>
</idea-plugin>
